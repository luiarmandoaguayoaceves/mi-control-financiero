{
  "name": "mi-control-financiero-web",
  "version": "2.0.0",
  "description": "Mi Control Financiero — app web estática (HTML + Tailwind + JS vanilla) para Android vía Capacitor",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "npx --yes serve -l 8080 .",
    "test": "node --test \"tests/*.test.js\"",
    "css": "npx @tailwindcss/cli -i src/input.css -o css/tailwind.css --minify",
    "icons": "node scripts/gen-icons.js",
    "icons:android": "node scripts/gen-android-icons.js",
    "www": "node scripts/build-www.js",
    "android:sync": "npm run www && cap sync android",
    "android:apk": "npm run android:sync && cd android && ./gradlew assembleDebug",
    "android:open": "cap open android"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0"
  }
}
